# Files excluded from Cloud Build source uploads.
.gcloudignore
.git/
.env
.env.*
!.env.example

# Local runtimes and caches
.venv/
.venv-broken/
.uv-cache/
.uv-python/
.pytest_cache/
.ruff_cache/
**/__pycache__/
*.py[cod]
node_modules/

# Runtime/generated data that is not part of the backend image
data/
logs/
log_F1/
!tests/fixtures/log_F1/
!tests/fixtures/log_F1/*.jsonl
.ai-log/
.tmp/
artifacts/
mentor_feedback/
build/

# Backend Cloud Run builds do not need documentation or frontend sources
docs/
presentation/
src/apps/web/
