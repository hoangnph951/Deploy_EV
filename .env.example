# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
# Required outside APP_ENV=test for agent tool selection, reflection,
# action drafting, simulator decisions, and safe-plan ranking.
AI_PLAN_EXPLANATION_ENABLED=false
AI_PLAN_EXPLANATION_TIMEOUT_SECONDS=12
OPENAI_STATION_FALLBACK_ENABLED=true
OPENAI_STATION_SEARCH_MODEL=gpt-5.4-mini
OPENAI_STATION_SEARCH_TIMEOUT_SECONDS=20
OPENAI_STATION_SEARCH_MAX_CANDIDATES=12
# Optional comma-separated web-search allowlist, for example vinfastauto.com
OPENAI_STATION_SEARCH_ALLOWED_DOMAINS=
OPENAI_RECOVERY_ENABLED=true
OPENAI_RECOVERY_MODEL=gpt-5.4-mini
OPENAI_RECOVERY_TIMEOUT_SECONDS=20
OPENAI_REPLANNING_ENABLED=true
OPENAI_REPLANNING_MODEL=gpt-5.4-mini
OPENAI_REPLANNING_PROMPT_VERSION=f4-supervisor-v3
OPENAI_REPLANNING_TIMEOUT_SECONDS=30
REPLANNING_MAX_LLM_TURNS=8
OPENAI_ENVIRONMENT_FALLBACK_ENABLED=true
OPENAI_ENVIRONMENT_SEARCH_MODEL=gpt-5.4-mini
OPENAI_ENVIRONMENT_SEARCH_TIMEOUT_SECONDS=20
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Team dev database (recommended): use the shared Supabase Session Pooler URL
# and ask the team for the current password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Optional local fallback:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Goong Maps (F1-US1/F1-US3) ----
# Public maptiles key: restrict by frontend referrer in Goong Console.
GOONG_MAPTILES_KEY=your-maptiles-key
# Private REST key: backend-only for Places, Geocoding and Directions.
GOONG_API_KEY=your-rest-api-key
GOONG_API_BASE_URL=https://rsapi.goong.io
GEOCODER_PROVIDER=goong
GEOCODER_TIMEOUT_SECONDS=4
GEOCODER_RESULT_LIMIT=5

# ---- Live F1-US3 providers ----
ROUTING_PROVIDER=goong
ROUTING_TIMEOUT_SECONDS=8
ROUTING_MAX_RETRIES=2
GOONG_MIN_REQUEST_INTERVAL_SECONDS=0.2
GOONG_RATE_LIMIT_COOLDOWN_SECONDS=30
MONITORING_MAX_OFF_ROUTE_DISTANCE_KM=2.0
MONITORING_MAX_SOC_DROP_DEVIATION_PERCENT=5.0
MONITORING_MAX_TELEMETRY_SILENT_SECONDS=60
STATION_PROVIDER=vinfast
STATION_CATALOG_DB_ENABLED=true
STATION_DATASET_REFRESH_SECONDS=300
STATION_DATASET_MAX_STALE_SECONDS=86400
STATION_DETAIL_REFRESH_SECONDS=300
STATION_DETAIL_MAX_STALE_SECONDS=86400
VINFAST_LOCATOR_META_URL=https://static-cms-prod.vinfastauto.com/locators/locators-meta.json
VINFAST_LOCATOR_DATASET_BASE_URL=https://static-cms-prod.vinfastauto.com/locators
VINFAST_LOCATOR_DETAIL_BASE_URL=https://vinfastauto.com/vn_vi/get-locator
VINFAST_TIMEOUT_SECONDS=15
VINFAST_MAX_RETRIES=2
VINFAST_ACCESS_DENIED_COOLDOWN_SECONDS=300
VINFAST_RATE_LIMIT_COOLDOWN_SECONDS=30
STATION_GRAPH_ENABLED=false
STATION_GRAPH_ROUTING_PROVIDER=osrm
STATION_GRAPH_MAX_NEIGHBORS=40
STATION_GRAPH_COARSE_RADIUS_KM=450
STATION_GRAPH_MAX_ROAD_LEG_KM=500
STATION_GRAPH_EDGE_MAX_AGE_SECONDS=86400
STATION_GRAPH_ROAD_VERSION=osrm-26.6.5-debian-driving-vietnam-v1
STATION_GRAPH_BUILD_ORIGIN_LIMIT=250
OSRM_BASE_URL=http://127.0.0.1:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=15
OSRM_MAX_RETRIES=1
OSRM_MAX_TABLE_LOCATIONS=100
OSRM_ROAD_VERSION_FILE=data/osrm/road-version.txt
REDIS_CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
PERSIST_ALL_PROPOSALS_ENABLED=true
PLANNER_ALGORITHM_VERSION=adaptive-beam-v1
ENERGY_MODEL_VERSION=energy-pilot-v1
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_TIMEOUT_SECONDS=8
OPEN_METEO_MAX_RETRIES=2
OPEN_METEO_RETRY_BASE_DELAY_SECONDS=0.5
OPEN_METEO_CACHE_TTL_SECONDS=10800
ENVIRONMENT_FALLBACK_ENABLED=true
ENVIRONMENT_FALLBACK_CONSUMPTION_MARGIN_PERCENT=20
ENVIRONMENT_CACHED_CONSUMPTION_MARGIN_PERCENT=5
ENVIRONMENT_WEB_SEARCH_CONSUMPTION_MARGIN_PERCENT=15
# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
AUTH_SESSION_TTL_HOURS=24
AUTH_REMEMBERED_SESSION_TTL_DAYS=30
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
