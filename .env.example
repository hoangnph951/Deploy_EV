OSRM_PROFILE=driving
OSRM_ROAD_VERSION_FILE=data/osrm/road-version.txt
REDIS_CACHE_ENABLED=false

# ---- Geocoding (F1-US1) ----
GEOCODER_PROVIDER=goong
GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
ROUTING_PROVIDER=goong
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# Google Maps Platform: dùng hai key riêng và không commit file này.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_COUNTRYCODES=vn
GEOCODER_USER_AGENT=ai-ev-agent/0.1
GEOCODER_TIMEOUT_SECONDS=4
GEOCODER_RESULT_LIMIT=5

# Hiển thị bản đồ frontend

GOONG_MAPTILES_KEY=
# Autocomplete, Place Detail, Direction và Geocoding

GOONG_API_KEY=
ROUTING_MAX_RETRIES=2
GOONG_MIN_REQUEST_INTERVAL_SECONDS=0.2
