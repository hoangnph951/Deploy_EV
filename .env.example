# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
#OPENAI_API_KEY=
OPENAI_RECOVERY_ENABLED=true
OPENAI_RECOVERY_MODEL=gpt-5.4
OPENAI_RECOVERY_TIMEOUT_SECONDS=20
OPENAI_REPLANNING_ENABLED=true
OPENAI_REPLANNING_MODEL=gpt-5.4-mini
OPENAI_REPLANNING_PROMPT_VERSION=f4-supervisor-v3
OPENAI_REPLANNING_TIMEOUT_SECONDS=30
REPLANNING_MAX_LLM_TURNS=12
OPENAI_ENVIRONMENT_FALLBACK_ENABLED=true
OPENAI_ENVIRONMENT_SEARCH_MODEL=gpt-5.4-mini
OPENAI_ENVIRONMENT_SEARCH_TIMEOUT_SECONDS=20
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
OPENAI_API_KEY=sk-9128a8abe5743459a88f95d413abb7130afc82ec5f0b0c6c5466151011a7a8b2
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.vilao.ai/v1
# ---- Database ----
DATABASE_URL=postgresql://postgres.qzdnqhuitkavsndujcba:hominhdungsohaimanhtran@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db
STATION_GRAPH_ENABLED=false
STATION_GRAPH_ROUTING_PROVIDER=osrm
STATION_GRAPH_MAX_NEIGHBORS=40
STATION_GRAPH_BUILD_ORIGIN_LIMIT=250
